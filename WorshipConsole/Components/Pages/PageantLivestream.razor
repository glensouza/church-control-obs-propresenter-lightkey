@page "/pageant/livestream"
@implements IDisposable
@inject IDbContextFactory<PageantDb> DbFactory
@inject ObsWebSocketService ObsService
@inject ViscaService ViscaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Pageant Livestream | Worship Console</PageTitle>

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-video text-teal me-3 fs-3"></i>
        <h1 class="fw-bold mb-0">Pageant Livestream</h1>
        <div class="ms-auto d-flex gap-3">
            <div class="d-flex align-items-center">
                <div class="status-dot @(ObsService.IsConnected ? "bg-success" : "bg-danger") me-2"></div>
                <span class="text-gray small">OBS: @(ObsService.IsConnected ? "Connected" : "Disconnected")</span>
            </div>
        </div>
    </div>

    @if (scripts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-teal" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-gray mt-3">Loading scripts...</p>
        </div>
    }
    else if (!scripts.Any())
    {
        <div class="card navy-light-bg text-white border-secondary p-5 text-center">
            <i class="fa-solid fa-film display-3 text-teal mb-3"></i>
            <h3 class="fw-bold">No Scripts Found</h3>
            <p class="text-gray mb-0">No pageant script entries have been added yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Navigation panel -->
            <div class="col-lg-3">
                <div class="card navy-light-bg text-white border-secondary h-100">
                    <div class="card-header border-secondary">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fa-solid fa-list-ol text-teal me-2"></i>Script Navigation
                        </h6>
                    </div>
                    <div class="card-body p-0 script-nav-body" style="max-height: 70vh; overflow-y: auto;">
                        @foreach (Script script in scripts)
                        {
                            <button class="btn w-100 text-start px-3 py-2 rounded-0 border-0 border-bottom border-secondary script-nav-btn @(currentScript?.Id == script.Id ? "active-scene" : "")"
                                    @onclick="() => SelectScene(script)">
                                <div class="small text-teal">@script.Act</div>
                                <div class="fw-semibold">@script.Scene</div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Main display -->
            <div class="col-lg-9">
                @if (currentScript == null)
                {
                    <div class="card navy-light-bg text-white border-secondary p-5 text-center">
                        <i class="fa-solid fa-hand-pointer display-3 text-teal mb-3"></i>
                        <h4 class="fw-bold">Select a Scene</h4>
                        <p class="text-gray">Click a scene from the navigation panel to view livestream cues.</p>
                    </div>
                }
                else
                {
                    <!-- Controls Bar -->
                    <div class="control-bar sticky-top mb-4">
                        <div class="d-flex justify-content-between gap-3 p-3 navy-light-bg rounded border border-secondary shadow-lg">
                            <button class="btn btn-outline-teal px-4 py-2 fw-bold" @onclick="PreviousScene" disabled="@(currentIndex <= 0)">
                                <i class="fa-solid fa-chevron-left me-2"></i><span class="d-none d-md-inline">PREV</span>
                            </button>
                            
                            <button class="btn btn-take px-5 py-3 fw-bold fs-3 flex-grow-1" @onclick="ExecuteCurrentScript" disabled="@(currentScript == null || isExecuting)">
                                @if (isExecuting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>EXECUTING...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-bolt-lightning me-2"></i><span>TAKE</span>
                                }
                            </button>

                            <button class="btn btn-teal-glow px-4 py-2 fw-bold fs-4" @onclick="NextScene" disabled="@(currentIndex >= scripts.Count - 1)">
                                <span class="d-none d-md-inline">NEXT </span>SCENE<i class="fa-solid fa-chevron-right ms-2"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Camera Cues -->
                    <div class="row g-3 mb-4">
                        @for (int i = 1; i <= Math.Max(4, cameras.Count); i++)
                        {
                            int camIndex = i;
                            string camName = i <= cameras.Count ? cameras[i - 1].Name : $"Camera {i}";
                            string action = GetCamAction(currentScript, camIndex);
                            int? preset = ParsePreset(action);
                            
                            <div class="col-md-3">
                                <div class="card navy-light-bg text-white border-secondary h-100">
                                    <div class="card-header border-secondary text-center py-2 bg-dark bg-opacity-50">
                                        <h6 class="mb-0 fw-bold">
                                            <i class="fa-solid fa-video text-teal me-2"></i>@camName
                                        </h6>
                                    </div>
                                    <div class="card-body text-center d-flex flex-column justify-content-center py-4">
                                        <div class="small text-graySmall mb-1">Preset</div>
                                        <div class="fs-2 fw-bold text-teal">@(preset.HasValue ? preset.Value.ToString() : "None")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- OBS Scene Switch & Script -->
                    <div class="card navy-light-bg text-white border-secondary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">
                                    <span class="badge bg-teal text-dark me-2">@currentScript.Act</span>
                                    @currentScript.Scene
                                </h5>
                                <div class="text-end">
                                    @if (remainingTime.HasValue)
                                    {
                                        <div class="countdown-active fw-bold text-teal fs-4">
                                            <i class="fa-solid fa-stopwatch me-2"></i>@remainingTime
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray small">
                                            <i class="fa-regular fa-clock me-1"></i>@currentScript.SceneLength sec
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(currentScript.SwitchToScene))
                            {
                                <div class="alert alert-obs mb-3 d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-film fs-4"></i>
                                    <div>
                                        <div class="small fw-semibold text-uppercase opacity-75">Switch OBS Scene To</div>
                                        <div class="fs-4 fw-bold">@GetFriendlySceneName(currentScript.SwitchToScene)</div>
                                        <div class="small opacity-50">(@currentScript.SwitchToScene)</div>
                                    </div>
                                </div>
                            }
                            <div class="bg-dark p-3 rounded border border-secondary">
                                <p class="mb-0 text-gray fs-5">@currentScript.Text</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Script>? scripts;
    private List<CameraInfo> cameras = [];
    private List<PageantObsScene> pageantScenes = [];
    private Script? currentScript;
    private int currentIndex = -1;
    private bool isExecuting;
    private int? remainingTime;
    private CancellationTokenSource? timerCts;

    protected override async Task OnInitializedAsync()
    {
        ObsService.StateChanged += StateHasChanged;
        if (!ObsService.IsConnected && !ObsService.IsConnecting)
        {
            _ = ObsService.ConnectAsync();
        }

        await LoadData();
    }

    public void Dispose()
    {
        ObsService.StateChanged -= StateHasChanged;
        CancelCountdown();
    }

    private async Task LoadData()
    {
        await using PageantDb db = await DbFactory.CreateDbContextAsync();
        List<Script> rawScripts = await db.Scripts.ToListAsync();
        scripts = rawScripts
            .OrderBy(s => s.Act)
            .ThenBy(s => s.Scene, new NaturalStringComparer())
            .ToList();
        cameras = await db.Cameras.OrderBy(c => c.Id).ToListAsync();
        pageantScenes = await db.PageantObsScenes.ToListAsync();
    }

    private string GetFriendlySceneName(string obsSceneName)
    {
        if (string.IsNullOrEmpty(obsSceneName)) return "None";
        PageantObsScene? mapping = pageantScenes.FirstOrDefault(s => s.ObsSceneName == obsSceneName);
        return mapping != null ? mapping.Name : obsSceneName;
    }

    private void SelectScene(Script script)
    {
        CancelCountdown();
        currentScript = script;
        currentIndex = scripts!.IndexOf(script);
        _ = HandleSceneChange();
    }

    private void NextScene()
    {
        if (scripts == null || currentIndex >= scripts.Count - 1) return;
        CancelCountdown();
        currentIndex++;
        currentScript = scripts[currentIndex];
        _ = HandleSceneChange();
    }

    private void PreviousScene()
    {
        if (scripts == null || currentIndex <= 0) return;
        CancelCountdown();
        currentIndex--;
        currentScript = scripts[currentIndex];
        _ = HandleSceneChange();
    }

    private void CancelCountdown()
    {
        timerCts?.Cancel();
        timerCts?.Dispose();
        timerCts = null;
        remainingTime = null;
    }

    private async Task StartCountdown(int seconds)
    {
        CancelCountdown();
        timerCts = new CancellationTokenSource();
        remainingTime = seconds;
        StateHasChanged();

        try
        {
            while (remainingTime > 0)
            {
                await Task.Delay(1000, timerCts.Token);
                remainingTime--;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task HandleSceneChange()
    {
        await Task.Yield(); // Let UI update
        await Task.Delay(50); // Small delay to ensure active-scene class is applied
        try
        {
            await JS.InvokeVoidAsync("scrollToActive", ".script-nav-body", ".active-scene");
        }
        catch { }
    }

    private async Task ExecuteCurrentScript()
    {
        if (currentScript == null || isExecuting) return;
        isExecuting = true;
        StateHasChanged();

        try
        {
            // 1. OBS Scene Switch (Execute First)
            if (!string.IsNullOrEmpty(currentScript.SwitchToScene) && ObsService.IsConnected)
            {
                await ObsService.SwitchSceneAsync(currentScript.SwitchToScene);
            }

            // 2. Camera Presets (Execute Second)
            List<Task> camTasks = [];
            for (int i = 1; i <= cameras.Count; i++)
            {
                string action = GetCamAction(currentScript, i);
                int? preset = ParsePreset(action);
                if (preset.HasValue)
                {
                    CameraInfo cam = cameras[i - 1];
                    camTasks.Add(ViscaService.RecallPresetAsync(cam.IpAddress, cam.ViscaPort, preset.Value));
                }
            }

            if (camTasks.Any())
            {
                await Task.WhenAll(camTasks);
            }

            // 3. Start Countdown (Based on Scene Length)
            if (currentScript.SceneLength > 0)
            {
                _ = StartCountdown(currentScript.SceneLength);
            }
        }
        catch (Exception)
        {
            // Log or show error
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }

    private int? ParsePreset(string action)
    {
        if (string.IsNullOrWhiteSpace(action)) return null;
        
        // Try to find the first number in the string
        string digits = new string(action.Where(char.IsDigit).ToArray());
        if (int.TryParse(digits, out int result) && result > 0) return result;
        
        return null;
    }

    private string GetCamAction(Script s, int i) => i switch { 
        1 => s.Camera1Action, 
        2 => s.Camera2Action, 
        3 => s.Camera3Action, 
        4 => s.Camera4Action, 
        _ => "" 
    };

    public class NaturalStringComparer : IComparer<string>
    {
        public int Compare(string? x, string? y)
        {
            if (x == y) return 0;
            if (x == null) return -1;
            if (y == null) return 1;
            string[] xParts = x.Split('.');
            string[] yParts = y.Split('.');
            for (int i = 0; i < Math.Min(xParts.Length, yParts.Length); i++)
            {
                if (int.TryParse(xParts[i], out int xInt) && int.TryParse(yParts[i], out int yInt))
                {
                    if (xInt != yInt) return xInt.CompareTo(yInt);
                }
                else
                {
                    int partCmp = string.Compare(xParts[i], yParts[i], StringComparison.OrdinalIgnoreCase);
                    if (partCmp != 0) return partCmp;
                }
            }
            return xParts.Length.CompareTo(yParts.Length);
        }
    }
}
